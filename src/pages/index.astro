---
import Layout from '@/layouts/Layout.astro';
import HeroSection from '@/components/home/astro/HeroSection.astro';
import HistoriaSection from '@/components/home/astro/HistoriaSection.astro';
import MenuSection from '@/components/home/react/MenuSection';
import AmbienteSection from '@/components/home/react/AmbienteSection';
import ReservacionesSection from '@/components/home/react/ReservacionesSection';
import Footer from '@/components/shared/astro/Footer.astro';
---

<Layout>
  <main>
    <HeroSection />
    <HistoriaSection />
    <MenuSection client:visible />
    <AmbienteSection client:visible />
    <ReservacionesSection client:visible />
  </main>
  <Footer />
</Layout>
