<section id="historia" class="relative overflow-hidden bg-dark py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-6 md:px-12">
    <div class="grid items-center gap-16 md:grid-cols-2 md:gap-20">
      <div class="historia-fade-in relative grid gap-4">
        <div class="space-y-4">
          <div
            class="p-5 text-black bg-gold font-medium flex flex-col items-center gap-1 w-max absolute -top-10 right-60 z-10"
          >
            <span class="uppercase text-xs">est.</span>
            <span
              class="historia-count italic text-xl"
              data-count-to="1998"
              data-count-from="1900"
            >
              1900
            </span>
          </div>
          <div class="overflow-hidden">
            <img
              src="/images/nuestra-historia-image.png"
              alt="Interior del restaurante Aurum"
              class="h-100 w-full object-cover transition-transform duration-700 hover:scale-105"
              loading="lazy"
            />
          </div>
          <div
            class="overflow-hidden absolute -top-12 -right-15 h-48 w-48 border-5 border-black"
          >
            <img
              src="/images/nuestra-historia-image-dish.png"
              alt="Chef preparando un plato"
              class="h-48 w-full object-cover transition-transform duration-700 hover:scale-105"
              loading="lazy"
            />
          </div>
        </div>

        <div
          class="pointer-events-none absolute -bottom-4 -left-4 h-24 w-24 border-b border-l border-gold/20"
        >
        </div>
      </div>
      <div class="historia-fade-in">
        <div class="mb-6 flex items-center gap-3">
          <span class="block h-px w-8 bg-gold"></span>
          <span class="font-body text-xs tracking-[3px] uppercase text-gold">
            Desde
            <span
              class="historia-count"
              data-count-to="2012"
              data-count-from="1990"
            >
              1990
            </span>
          </span>
        </div>

        <h2
          class="font-heading text-[clamp(2rem,4vw,3.5rem)] font-light leading-tight tracking-wide text-white"
        >
          Nuestra <span class="italic text-gold">Historia</span>
        </h2>

        <p class="mt-6 text-base leading-relaxed text-text-secondary">
          Aurum nació de la pasión por la alta cocina y el deseo de crear un
          espacio donde cada detalle importa. Nuestro chef ejecutivo, formado en
          las mejores escuelas culinarias de Europa, fusiona técnicas clásicas
          francesas con los sabores más vibrantes de la gastronomía
          latinoamericana.
        </p>

        <p class="mt-4 text-base leading-relaxed text-text-secondary">
          Cada ingrediente es seleccionado con esmero, cada plato es una obra de
          arte, y cada visita se convierte en un recuerdo inolvidable. En Aurum,
          no solo servimos comida — creamos experiencias.
        </p>

        <div class="mt-10 flex items-center gap-8">
          <div>
            <span
              class="historia-count font-heading text-4xl font-light text-gold"
              data-count-to="12"
              data-suffix="+"
            >
              0+
            </span>
            <p
              class="mt-1 text-xs tracking-wider text-text-secondary uppercase"
            >
              Años de historia
            </p>
          </div>
          <span class="h-10 w-px bg-border-subtle"></span>
          <div>
            <span
              class="historia-count font-heading text-4xl font-light text-gold"
              data-count-to="50"
              data-suffix="k+"
            >
              0k+
            </span>
            <p
              class="mt-1 text-xs tracking-wider text-text-secondary uppercase"
            >
              Clientes felices
            </p>
          </div>
          <span class="h-10 w-px bg-border-subtle"></span>
          <div>
            <span
              class="historia-count font-heading text-4xl font-light text-gold"
              data-count-to="3"
            >
              0
            </span>
            <p
              class="mt-1 text-xs tracking-wider text-text-secondary uppercase"
            >
              Estrellas Michelin
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { useCountUp } from '@/hooks/useCountUp';

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll('.historia-fade-in').forEach((el) => {
    gsap.from(el, {
      y: 60,
      opacity: 0,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
    });
  });

  useCountUp('.historia-count', { duration: 2 });
</script>
