---
import { Button } from '@/components/shared/react/Button';
---

<footer class="border-t border-border-subtle bg-dark">
  <div class="mx-auto max-w-7xl px-6 py-16 md:px-12">
    <div class="grid gap-12 md:grid-cols-4">
      <!-- Logo & Description -->
      <div class="md:col-span-1">
        <a href="/" class="inline-flex items-center gap-3 no-underline">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#C9A962"
            stroke-width="1.5"
          >
            <path
              d="M2.7 10.3a2.41 2.41 0 0 0 0 3.41l7.59 7.59a2.41 2.41 0 0 0 3.41 0l7.59-7.59a2.41 2.41 0 0 0 0-3.41l-7.59-7.59a2.41 2.41 0 0 0-3.41 0Z"
            ></path>
          </svg>
          <span
            class="font-heading text-2xl font-semibold tracking-[4px] text-gold"
          >
            AURUM
          </span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          Una experiencia gastronómica donde la excelencia se encuentra con la
          elegancia. Cada visita es un viaje para los sentidos.
        </p>
        <!-- Social Icons -->
        <div class="mt-6 flex gap-4">
          <a
            href="#"
            aria-label="Instagram"
            class="flex h-9 w-9 items-center justify-center border border-border-subtle text-text-secondary transition-all hover:border-gold hover:text-gold"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="#"
            aria-label="Facebook"
            class="flex h-9 w-9 items-center justify-center border border-border-subtle text-text-secondary transition-all hover:border-gold hover:text-gold"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            aria-label="X / Twitter"
            class="flex h-9 w-9 items-center justify-center border border-border-subtle text-text-secondary transition-all hover:border-gold hover:text-gold"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4
          class="mb-4 font-body text-xs font-medium tracking-[2px] uppercase text-white"
        >
          Navegación
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="#hero"
              class="text-sm text-text-secondary no-underline transition-colors hover:text-gold"
            >
              Inicio
            </a>
          </li>
          <li>
            <a
              href="#historia"
              class="text-sm text-text-secondary no-underline transition-colors hover:text-gold"
            >
              Nuestra Historia
            </a>
          </li>
          <li>
            <a
              href="#menu"
              class="text-sm text-text-secondary no-underline transition-colors hover:text-gold"
            >
              Menú
            </a>
          </li>
          <li>
            <a
              href="#ambiente"
              class="text-sm text-text-secondary no-underline transition-colors hover:text-gold"
            >
              Ambiente
            </a>
          </li>
          <li>
            <a
              href="#reservaciones"
              class="text-sm text-text-secondary no-underline transition-colors hover:text-gold"
            >
              Reservaciones
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4
          class="mb-4 font-body text-xs font-medium tracking-[2px] uppercase text-white"
        >
          Contacto
        </h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-2">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#C9A962"
              stroke-width="1.5"
              class="mt-0.5 shrink-0"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span class="text-sm text-text-secondary">
              Av. Paseo de la Reforma 250,<br /> Col. Juárez, CDMX
            </span>
          </li>
          <li class="flex items-center gap-2">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#C9A962"
              stroke-width="1.5"
              class="shrink-0"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            <span class="text-sm text-text-secondary">+52 (55) 1234 5678</span>
          </li>
          <li class="flex items-center gap-2">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#C9A962"
              stroke-width="1.5"
              class="shrink-0"
            >
              <path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span class="text-sm text-text-secondary">reservas@aurum.mx</span>
          </li>
        </ul>
      </div>

      <!-- Hours -->
      <div>
        <h4
          class="mb-4 font-body text-xs font-medium tracking-[2px] uppercase text-white"
        >
          Horario
        </h4>
        <ul class="space-y-3">
          <li class="flex justify-between text-sm">
            <span class="text-text-secondary">Lunes - Viernes</span>
            <span class="text-white">12:00 - 23:00</span>
          </li>
          <li class="flex justify-between text-sm">
            <span class="text-text-secondary">Sábado</span>
            <span class="text-white">13:00 - 00:00</span>
          </li>
          <li class="flex justify-between text-sm">
            <span class="text-text-secondary">Domingo</span>
            <span class="text-white">13:00 - 22:00</span>
          </li>
        </ul>
        <div class="mt-6">
          <Button
            href="#reservaciones"
            variant="outline"
            className="inline-block px-6 py-3"
          >
            Reservar Ahora
          </Button>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border-subtle pt-8 md:flex-row"
    >
      <p class="text-xs text-text-muted">
        &copy; 2026 Aurum Restaurant. Todos los derechos reservados.
      </p>
      <div class="flex gap-6">
        <a
          href="#"
          class="text-xs text-text-muted no-underline transition-colors hover:text-gold"
        >
          Política de Privacidad
        </a>
        <a
          href="#"
          class="text-xs text-text-muted no-underline transition-colors hover:text-gold"
        >
          Términos y Condiciones
        </a>
      </div>
    </div>
  </div>
</footer>
